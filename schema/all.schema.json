{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Munitorum Field Manual dataset",
  "description": "all.json, a release asset: meta.yaml and every faction file, at schemaVersion 2. See https://github.com/BSData/wh40k-11e-mfm/blob/main/specs/data-model.md",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 2
    },
    "meta": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 2
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "lastUpdated": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "notes": {
          "type": "string",
          "minLength": 1
        },
        "muster": {
          "type": "string",
          "minLength": 1
        },
        "factions": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "schemaVersion",
        "version",
        "lastUpdated",
        "factions"
      ]
    },
    "factions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "parent": {
            "type": "string",
            "minLength": 1
          },
          "detachments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "dp": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "objectives": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "unique": {
                  "type": "string",
                  "minLength": 1
                },
                "enhancements": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "points": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "leaderTo": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "supportTo": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    "required": [
                      "name",
                      "points"
                    ]
                  }
                }
              },
              "required": [
                "name",
                "dp",
                "objectives",
                "enhancements"
              ]
            }
          },
          "units": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "groupTitle": {
                  "type": "string",
                  "minLength": 1
                },
                "pricing": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "range": {
                        "type": "string",
                        "pattern": "^\\[\\d+,(?:\\d+\\]|\\))$"
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1
                      },
                      "costs": {
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "models": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            },
                            "points": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            },
                            "desc": {
                              "type": "string",
                              "minLength": 1
                            },
                            "addon": {
                              "type": "boolean",
                              "const": true
                            }
                          },
                          "required": [
                            "models",
                            "points"
                          ]
                        }
                      }
                    },
                    "required": [
                      "range",
                      "label",
                      "costs"
                    ]
                  }
                },
                "leaderTo": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "supportTo": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "wargear": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "item": {
                        "type": "string",
                        "minLength": 1
                      },
                      "points": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "item",
                      "points"
                    ]
                  }
                },
                "legends": {
                  "type": "boolean",
                  "const": true
                }
              },
              "required": [
                "name",
                "pricing"
              ]
            }
          },
          "firstSeen": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "required": [
          "slug",
          "name",
          "version",
          "detachments",
          "units",
          "firstSeen"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "meta",
    "factions"
  ]
}
