{
  "name": "wh40k-mfm-scraper",
  "version": "0.1.0",
  "private": true,
  "description": "Scrapes the Warhammer 40,000 Munitorum Field Manual into versioned YAML and tracks points changes over time.",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "scrape": "tsx src/bin/mfm.ts scrape",
    "mfm": "tsx src/bin/mfm.ts",
    "refresh-fixtures": "tsx src/bin/mfm.ts refresh-fixtures",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "check-data": "tsx src/bin/mfm.ts check-data",
    "verify": "pnpm check && pnpm typecheck && pnpm test && pnpm check-data"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "fflate": "^0.8.3",
    "node-html-markdown": "^2.0.0",
    "playwright-core": "^1.64.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.5",
    "ajv": "^8.20.0",
    "lefthook": "^2.2.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
